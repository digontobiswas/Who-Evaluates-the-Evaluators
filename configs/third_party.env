# Third-party code and interpreter pins. Read by scripts/setup_env.sh.
# Changing a pin changes what every later result was computed with: commit the change.

# CPython for the venv. The cluster's own Python 3 lacks a working ssl module, so we unpack a
# relocatable build instead (python-build-standalone, needs glibc >= 2.17).
PYTHON_STANDALONE_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20251031/cpython-3.9.25%2B20251031-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"
PYTHON_STANDALONE_SHA256="fe04e8b27bd69ca2144fc542428f8b9b5287b6a2e45516a4acfe2c2bc3102773"
PYTHON_STANDALONE_VERSION="3.9.25"

# NAVSIM v1 devkit: branch v1.1 (navtest, PDMS).
NAVSIM_V1_URL="https://github.com/autonomousvision/navsim.git"
NAVSIM_V1_REF="v1.1"
NAVSIM_V1_COMMIT="3e8291bfa89ff247231e0227778840cd0a036896"

# NAVSIM v2 devkit: branch main (navhard, EPDMS). Not used by the stage 1 PDMS job.
NAVSIM_V2_URL="https://github.com/autonomousvision/navsim.git"
NAVSIM_V2_REF="main"
NAVSIM_V2_COMMIT="0a380a9063d7162ec93d0f51e9990ebac585f720"

# nuPlan devkit, the version NAVSIM's requirements.txt asks for.
NUPLAN_DEVKIT_URL="https://github.com/motional/nuplan-devkit.git"
NUPLAN_DEVKIT_REF="nuplan-devkit-v1.2"
NUPLAN_DEVKIT_COMMIT="ce3c323af01c0d7ec5672f7832ef53f9c679aab0"

# BridgeSim closed-loop evaluator (CoRL 2026), with its vendored MetaDrive 0.4.3.
# Read by scripts/setup_bridgesim.sh; the environment is requirements/bridgesim-cp39-manylinux2014.lock.txt.
BRIDGESIM_URL="https://github.com/VAIL-UCLA/BridgeSim.git"
BRIDGESIM_REF="main"
BRIDGESIM_COMMIT="ea5d45f571ad934e09152e3f9c0fbe7d4c2f37db"
