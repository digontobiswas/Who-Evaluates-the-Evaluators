# Cluster settings. Copy this file to configs/hpc/cluster.env (git-ignored) and fill it in.
#
# Nothing here is guessed. Take every value from a command you ran on the cluster:
#   bash scripts/hpc_probe.sh 2>&1 | tee hpc_probe_login.txt
# Plain KEY=value lines, no spaces around "=". Leave optional values empty.

# --- storage -------------------------------------------------------------------------------
# REQUIRED. Workspace on scratch: data, checkpoints, caches, third-party code, experiment
# outputs and SLURM logs all live below it. Example shape: /scratch/<your user>/wete
WETE_ROOT=

# Optional. Where virtual environments go (several GB). Default: $WETE_ROOT/venvs.
# Put it under $HOME only if `myquota` shows room; scratch may be purged after a retention period.
WETE_VENV_ROOT=

# --- SLURM ---------------------------------------------------------------------------------
# REQUIRED for CPU jobs (metric caching, NAVSIM v1 scoring). Partition name from `sinfo`.
WETE_CPU_PARTITION=
# REQUIRED for CPU jobs. Cores per job, within what the partition allows.
WETE_CPU_CPUS_PER_TASK=
# REQUIRED for CPU jobs. Wall time as D-HH:MM:SS or HH:MM:SS, within the partition limit.
WETE_CPU_TIME=
# Optional. Memory request, e.g. 64G. Empty = partition default.
WETE_CPU_MEM=

# REQUIRED for GPU jobs (none yet in stage 1). Partition name from `sinfo`.
WETE_GPU_PARTITION=
# REQUIRED for GPU jobs. Generic resource string exactly as `sinfo -o "%P %G"` shows it.
WETE_GPU_GRES=
WETE_GPU_CPUS_PER_TASK=
WETE_GPU_TIME=
WETE_GPU_MEM=

# Optional. Only if your allocation needs them.
WETE_ACCOUNT=
WETE_QOS=

# --- software ------------------------------------------------------------------------------
# Optional. Space-separated modules to load at the start of every job. The NAVSIM
# environment needs none: PyTorch wheels bundle their CUDA libraries.
WETE_MODULES=

# Optional. Path to an existing Python 3.9 interpreter with working ssl and lzma modules.
# Empty = scripts/setup_env.sh unpacks the pinned relocatable CPython from configs/third_party.env.
WETE_PYTHON=
