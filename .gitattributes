# Normalise text files; let git decide what is text.
* text=auto

# Anything executed on the cluster must keep LF endings, even when checked out on Windows.
*.sh      text eol=lf
*.sbatch  text eol=lf
*.env     text eol=lf
*.example text eol=lf
*.py      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.in      text eol=lf
*.md      text eol=lf

# Binary documents and figures.
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
